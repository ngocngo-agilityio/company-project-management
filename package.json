{
  "name": "company-board",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "lint": "turbo run lint && eslint \"*.js\" && prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "db:migrate": "pnpm --filter @board/backend db:migrate",
    "db:deploy": "pnpm --filter @board/backend db:deploy",
    "db:seed": "pnpm --filter @board/backend db:seed",
    "storybook": "pnpm --filter @board/ui storybook",
    "build-storybook": "pnpm --filter @board/ui build-storybook",
    "test:a11y": "pnpm --filter @board/ui test:a11y",
    "e2e": "pnpm --filter @board/web test:e2e",
    "e2e:ui": "pnpm --filter @board/web test:e2e --ui",
    "e2e:setup": "pnpm --filter @board/web exec playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,yaml,yml}": "prettier --write"
  }
}
