# Copy to .env and fill in values. Names only here: never put real secrets in this file.

# ── Backend server ──────────────────────────
PORT=
HOST=
# Web app origin allowed to call the API (CORS). Empty = no CORS.
WEB_ORIGIN=

# ── Database (local Docker or Supabase) ─────
DATABASE_URL=
# Leave empty. Set to 1 only to let db:* scripts run on a non-local database.
ALLOW_REMOTE_DB=

# ── First Super Admin (used by pnpm db:seed) ─
SUPER_ADMIN_EMAIL=
# Optional. Default: the part of the email before @.
SUPER_ADMIN_NAME=

# ── Google sign-in ─────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── Web app build ───────────────────────────
# API address the web build calls
VITE_API_URL=
