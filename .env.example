# Copy to .env and fill in values. Names only here: never put real secrets in this file.

# ── Backend server ──────────────────────────
PORT=
HOST=
# Web app origin allowed to call the API (CORS). Empty = no CORS.
WEB_ORIGIN=

# ── Database (local Docker or Supabase) ─────
DATABASE_URL=
# Leave empty. Set to 1 only to let db:* scripts run on a non-local database.
ALLOW_REMOTE_DB=

# ── Install settings (used by pnpm db:seed) ─
SUPER_ADMIN_EMAIL=
# Optional. Default: the part of the email before @.
SUPER_ADMIN_NAME=
# Optional. IANA time zone name. Default: Asia/Ho_Chi_Minh.
COMPANY_TIMEZONE=

# ── Google sign-in ─────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Leave empty (0) locally. Set 1 on Render: the web app and the API are on different addresses,
# so the session cookie is Secure + SameSite=None.
COOKIE_CROSS_SITE=
# Leave empty (0) locally. Set 1 on Render: the API is behind a proxy, so the rate limit reads the real
# client address from X-Forwarded-For.
TRUST_PROXY=
# Leave empty (0). Set 1 only for browser end-to-end tests: adds POST /api/test/login. The server refuses it
# in production, on Render and with a database that is not local.
E2E=

# Contact address shown on the public /about and /privacy pages (Google asks for one). Optional.
CONTACT_EMAIL=

# ── Web app build ───────────────────────────
# API address the web build calls
VITE_API_URL=
