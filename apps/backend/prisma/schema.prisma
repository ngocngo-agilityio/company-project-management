generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  MEMBER
  OBSERVER

  @@map("membership_role")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED

  @@map("invitation_status")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  // Always lowercase: normalise with `normalizeEmail` from @board/shared before saving.
  email         String    @unique
  name          String
  avatarUrl     String?   @map("avatar_url")
  googleId      String?   @unique @map("google_id")
  isSuperAdmin  Boolean   @default(false) @map("is_super_admin")
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions        Session[]
  memberships     Membership[]
  invitationsSent Invitation[]

  @@map("user")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Project {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  invitations Invitation[]
  boards      Board[]

  @@map("project")
}

model Membership {
  id        String         @id @default(uuid()) @db.Uuid
  projectId String         @map("project_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Restrict: a user who still has memberships cannot be hard-deleted (deactivate instead).
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("membership")
}

// One Pending invitation per (project, email) is enforced by a partial unique index
// written by hand in the migration SQL (Prisma cannot express it).
model Invitation {
  id          String           @id @default(uuid()) @db.Uuid
  projectId   String           @map("project_id") @db.Uuid
  // Always lowercase. Matched against the Google account email at sign-in.
  email       String
  role        MembershipRole
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(3)
  invitedById String           @map("invited_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User    @relation(fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([projectId, status])
  @@index([email])
  @@map("invitation")
}

model Board {
  id         String    @id @default(uuid()) @db.Uuid
  projectId  String    @map("project_id") @db.Uuid
  name       String
  position   Decimal   @db.Decimal(20, 10)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lists   List[]

  @@index([projectId, position])
  @@map("board")
}

model List {
  id         String    @id @default(uuid()) @db.Uuid
  boardId    String    @map("board_id") @db.Uuid
  name       String
  position   Decimal   @db.Decimal(20, 10)
  isFinished Boolean   @default(false) @map("is_finished")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, position])
  @@map("list")
}
